# Google Cloud Platform & BigQuery Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_USER_IDENTITY=user@example.com
BQ_DATASET_ID=ecommerce_dw
BQ_LOCATION=us-central1

# Gemini Enterprise Agent Platform (Conversational Analytics API)
CA_API_HOST=https://geminidataanalytics.googleapis.com
CA_API_ENDPOINT=https://geminidataanalytics.googleapis.com/v1beta/projects/${GCP_PROJECT_ID}/locations/global:chat
DATA_AGENT_ID=gda-lumiere-primary

# UI Screen Flow Configuration (Initial User Name Input Screen)
# Set to "on" to display Screen 0 Operator Name Entry (>=5 chars required)
# Set to "off" to bypass Screen 0 with an automated 8-character operator identifier
USER_NAME_SCREEN=on
